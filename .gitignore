# ── macOS ─────────────────────────────────────────────
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# ── Obsidian 运行时状态 ───────────────────────────────
# 注意：.obsidian/ 下的配置文件应当提交
# （app.json / appearance.json / hotkeys.json / core-plugins.json）
# 以下只是窗口布局、缓存与回收站，随仓库同步只会制造无意义冲突
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph.json
.trash/

# ── 编辑器 / IDE ──────────────────────────────────────
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
~$*

# ── Agent 运行时数据 ──────────────────────────────────
# memory 里的工作日志跨设备有用，保留；其余会话与缓存不入版本库
.workbuddy/*
!.workbuddy/memory/

# ── 临时文件 ──────────────────────────────────────────
*.tmp
*.bak
*.log
